{
  "expo": {
    "name": "Black Box Barbers",
    "slug": "black-box-barbers",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "blackboxbarbers",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-location"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Black Box Barbers uses your location to find nearby barber shops."
      }
    },
    "android": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0F1115"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
